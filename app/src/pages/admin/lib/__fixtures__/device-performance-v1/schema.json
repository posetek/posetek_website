{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posetek.net/contracts/device-performance-v1/schema.json",
  "title": "PoseTek device performance record V1",
  "description": "One client-submitted device-performance fact (plan 07 section 4). Binding definitions, metric semantics and limits live in docs/plans/PROCESSING_PERF_CONTRACTS_V1.md section 8. Server-assigned fields (firstReceivedAtServer, updatedAtServer, digest) are never part of a client record. x-maxEncodedBytes is a custom annotation: the UTF-8 byte length of the RFC 8785 canonical JSON of the instance must not exceed it; validators enforce it outside JSON Schema.",
  "x-posetekContract": {
    "name": "device-performance-v1",
    "performanceSchemaVersion": 1,
    "status": "frozen v1.2.2 - 2026-09-29",
    "canonicalCopy": "PoseTek-mobile-app/tools/contracts/device-performance-v1/schema.json",
    "pinnedCopy": "posetek_website/functions/contracts/device-performance-v1/schema.json",
    "document": "PoseTek-mobile-app/docs/plans/PROCESSING_PERF_CONTRACTS_V1.md"
  },
  "x-maxEncodedBytes": 16384,
  "$ref": "#/$defs/recordV1",
  "$defs": {
    "uuidLower": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuidAnyCase": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "launchId": {
      "description": "Diagnostics.launchID verbatim: an uppercase UUID string, compared exactly, never case-folded.",
      "type": "string",
      "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uploadGroupId": {
      "description": "Upload group id (contract section 8.6): <attemptId>:<category> for an attempt's group, or system:<category>:<originInstallId> for a group with no attempt (v1.2, D-21).",
      "type": "string",
      "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:(resultFiles|optionalVideo|legacyVideo|diagnostics)|system:(resultFiles|optionalVideo|legacyVideo|diagnostics):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "clientTimestamp": {
      "description": "Client wall-clock date, UTC, millisecond precision. Never used to compute a local duration.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "nonNegNumberOrNull": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "nonNegIntegerOrNull": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "stageId": {
      "description": "A ProcessingStage raw value (contract section 1). Unknown values are preserved verbatim by readers.",
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$"
    },
    "drillType": {
      "enum": ["jump", "deadballShot", "sprint", "broadJump", "changeOfDirection", "dribbling", "freeRecord"]
    },
    "processingMode": {
      "description": "ProcessingRunMode raw values (ProcessingDiagnosticsModels.swift:50-56).",
      "enum": ["liveCapture", "debugReview", "recovery", "validation", "fixture"]
    },
    "outcomeV1": {
      "description": "Run compute outcome (contract section 8.3). Fixed at run end; the measurement verdict lives on the attempt fact.",
      "enum": ["valid", "partial", "noMeasurement", "failed", "cancelled", "interruptedUnknown"]
    },
    "failureCode": {
      "description": "A ProcessingFailureCode raw value; unknown values are kept verbatim.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "failureLayer": {
      "enum": ["input", "decoder", "model", "algorithm", "resource", "persistence", "runtime", "unknown"]
    },
    "missingReason": {
      "enum": [
        "notCollectedByThisVersion",
        "crossLaunch",
        "clockUnavailable",
        "notReached",
        "notApplicable",
        "droppedOnSaturation",
        "truncated",
        "interrupted",
        "unavailable",
        "pendingUpload"
      ]
    },
    "missingReasonEntry": {
      "description": "field is a JSON Pointer into body (empty string = the whole record). The value it points at must be null; validators check that outside JSON Schema.",
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason"],
      "properties": {
        "field": {"type": "string", "maxLength": 128, "pattern": "^(/[A-Za-z][A-Za-z0-9]*(/[0-9]+)?)*$"},
        "reason": {"$ref": "#/$defs/missingReason"}
      }
    },
    "platformRef": {
      "description": "ProcessingPlatformSnapshot plus app version/build (ProcessingDiagnosticsModels.swift:250-333).",
      "type": "object",
      "additionalProperties": false,
      "required": ["appVersion", "build", "sourceRevision", "machine", "osVersion", "configuration"],
      "properties": {
        "appVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "build": {"type": "string", "minLength": 1, "maxLength": 64},
        "sourceRevision": {"type": "string", "minLength": 1, "maxLength": 128},
        "machine": {"type": "string", "minLength": 1, "maxLength": 64},
        "osVersion": {"type": "string", "minLength": 1, "maxLength": 128},
        "configuration": {"enum": ["Debug", "Release"]}
      }
    },
    "platformRefOrNull": {
      "anyOf": [{"$ref": "#/$defs/platformRef"}, {"type": "null"}]
    },
    "policyVersion": {
      "description": "ProcessingPolicyVersion (contract section 2.3). hash = SHA-256 of the canonical component string.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hash", "components"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$"},
        "hash": {"$ref": "#/$defs/sha256Hex"},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ballSampling",
            "kickExactStop",
            "kickNormalMotion",
            "kickPassFusion",
            "reviewConstruction",
            "sessionCalibrationInput",
            "captureProfileFinalizeCheck"
          ],
          "properties": {
            "ballSampling": {"enum": ["dense", "adaptiveSparse"]},
            "captureProfileFinalizeCheck": {"enum": ["off", "on"]},
            "kickExactStop": {"enum": ["off", "on"]},
            "kickNormalMotion": {"enum": ["computed", "omitted"]},
            "kickPassFusion": {"enum": ["off", "on"]},
            "reviewConstruction": {"enum": ["eager", "lazy"]},
            "sessionCalibrationInput": {"enum": ["legacy", "frozenSnapshot"]}
          }
        }
      }
    },
    "policyVersionOrNull": {
      "anyOf": [{"$ref": "#/$defs/policyVersion"}, {"type": "null"}]
    },
    "massRecordV1": {
      "description": "MassRecord (contract section 3.2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["valueKg", "units", "source", "snapshotVersion"],
      "properties": {
        "valueKg": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 400},
        "units": {"const": "kg"},
        "source": {"enum": ["eventSnapshot", "firestoreProfile", "fallbackDefault", "missing"]},
        "snapshotVersion": {"const": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "missing"}}, "required": ["source"]},
          "then": {"properties": {"valueKg": {"type": "null"}}},
          "else": {"properties": {"valueKg": {"type": "number"}}}
        },
        {
          "if": {"properties": {"source": {"const": "fallbackDefault"}}, "required": ["source"]},
          "then": {"properties": {"valueKg": {"const": 70}}}
        }
      ]
    },
    "stageSummaryV1": {
      "description": "StageSummaryV1 (contract section 1.4). Durations are finite, non-negative and null when unavailable; zero only when measured.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageId",
        "parentStageId",
        "passId",
        "status",
        "invocationCount",
        "elapsedMs",
        "activeMs",
        "continuousElapsedMs",
        "timingKind",
        "framesDecoded",
        "modelCalls",
        "missingObservations",
        "failureCode",
        "failureLayer",
        "lastDurableStage"
      ],
      "properties": {
        "stageId": {"$ref": "#/$defs/stageId"},
        "parentStageId": {"anyOf": [{"$ref": "#/$defs/stageId"}, {"type": "null"}]},
        "passId": {"anyOf": [{"$ref": "#/$defs/stageId"}, {"type": "null"}]},
        "status": {"enum": ["completed", "failed", "cancelled", "interrupted", "notNeeded", "notReached", "unavailable"]},
        "invocationCount": {"type": "integer", "minimum": 0, "maximum": 100000},
        "elapsedMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "activeMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "continuousElapsedMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "timingKind": {"enum": ["mainPhase", "nestedOperation"]},
        "framesDecoded": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "modelCalls": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "missingObservations": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "failureCode": {"anyOf": [{"$ref": "#/$defs/failureCode"}, {"type": "null"}]},
        "failureLayer": {"anyOf": [{"$ref": "#/$defs/failureLayer"}, {"type": "null"}]},
        "lastDurableStage": {"anyOf": [{"$ref": "#/$defs/stageId"}, {"type": "null"}]}
      },
      "if": {"properties": {"timingKind": {"const": "nestedOperation"}}, "required": ["timingKind"]},
      "then": {"properties": {"parentStageId": {"$ref": "#/$defs/stageId"}}}
    },
    "resourceSampleV1": {
      "description": "ProcessingResourceSnapshot at admission/release. The telemetry payload's -1 sentinel becomes null here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["footprintBytes", "availableBytes", "freeDiskBytes", "pendingUploads", "thermalState"],
      "properties": {
        "footprintBytes": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "availableBytes": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "freeDiskBytes": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "pendingUploads": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "thermalState": {"enum": ["nominal", "fair", "serious", "critical", "unknown"]}
      }
    },
    "resourceSampleOrNull": {
      "anyOf": [{"$ref": "#/$defs/resourceSampleV1"}, {"type": "null"}]
    },
    "attemptSummaryBodyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "spans",
        "continuousSpans",
        "inputSource",
        "captureFormat",
        "measurementVerdict",
        "verdictReason",
        "stationVerdict",
        "preAdmissionFailure",
        "primaryMetricFinite",
        "requiredSaveState",
        "sidecarState",
        "archiveState",
        "runCount",
        "acceptedRunId",
        "launchSegmentCount",
        "lifecycleTransitionCount"
      ],
      "properties": {
        "stages": {"type": "array", "maxItems": 48, "items": {"$ref": "#/$defs/stageSummaryV1"}},
        "spans": {"$ref": "#/$defs/clientSpansV1"},
        "continuousSpans": {"$ref": "#/$defs/clientSpansV1"},
        "inputSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calibration", "mass", "snapshotIdentityHash"],
          "properties": {
            "calibration": {"enum": ["stationBundle", "stationMarker", "frozenSnapshot", "sessionDownload", "inVideoSearch", "notApplicable", "unknown"]},
            "mass": {"anyOf": [{"$ref": "#/$defs/massRecordV1"}, {"type": "null"}]},
            "snapshotIdentityHash": {"anyOf": [{"$ref": "#/$defs/sha256Hex"}, {"type": "null"}]}
          }
        },
        "captureFormat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestedFPS", "appliedFPS", "formatWidth", "formatHeight", "measuredNominalFPS", "measuredDurationSeconds", "uprightWidth", "uprightHeight"],
          "properties": {
            "requestedFPS": {"$ref": "#/$defs/nonNegNumberOrNull"},
            "appliedFPS": {"$ref": "#/$defs/nonNegNumberOrNull"},
            "formatWidth": {"$ref": "#/$defs/nonNegIntegerOrNull"},
            "formatHeight": {"$ref": "#/$defs/nonNegIntegerOrNull"},
            "measuredNominalFPS": {"$ref": "#/$defs/nonNegNumberOrNull"},
            "measuredDurationSeconds": {"$ref": "#/$defs/nonNegNumberOrNull"},
            "uprightWidth": {"$ref": "#/$defs/nonNegIntegerOrNull"},
            "uprightHeight": {"$ref": "#/$defs/nonNegIntegerOrNull"}
          }
        },
        "measurementVerdict": {"enum": ["pending", "valid", "invalid"]},
        "verdictReason": {"enum": [null, "noMeasurement", "wrongSide", "processingFailed", "userDiscarded", "awaitingRetry", "interrupted"]},
        "stationVerdict": {"enum": ["valid", "processingFailed", "noMeasurement", "wrongSide", "notApplicable", "unknown"]},
        "preAdmissionFailure": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "failureCode", "failureLayer"],
              "properties": {
                "stage": {"$ref": "#/$defs/stageId"},
                "failureCode": {"$ref": "#/$defs/failureCode"},
                "failureLayer": {"$ref": "#/$defs/failureLayer"}
              }
            }
          ]
        },
        "primaryMetricFinite": {"type": ["boolean", "null"]},
        "requiredSaveState": {"enum": ["notQueued", "queued", "committed", "failed", "cancelled", "notApplicable"]},
        "sidecarState": {"enum": ["notRequested", "pending", "uploaded", "failed"]},
        "archiveState": {"enum": ["notRequested", "pending", "uploaded", "failed", "unavailable"]},
        "runCount": {"type": "integer", "minimum": 0, "maximum": 64},
        "acceptedRunId": {"anyOf": [{"$ref": "#/$defs/uuidLower"}, {"type": "null"}]},
        "launchSegmentCount": {"type": "integer", "minimum": 1, "maximum": 1000},
        "lifecycleTransitionCount": {"type": "integer", "minimum": 0, "maximum": 100000}
      },
      "allOf": [
        {
          "if": {"properties": {"measurementVerdict": {"const": "valid"}}, "required": ["measurementVerdict"]},
          "then": {"properties": {"verdictReason": {"type": "null"}}}
        },
        {
          "if": {"properties": {"measurementVerdict": {"const": "invalid"}}, "required": ["measurementVerdict"]},
          "then": {"properties": {"verdictReason": {"enum": ["noMeasurement", "wrongSide", "processingFailed", "userDiscarded"]}}}
        },
        {
          "if": {"properties": {"measurementVerdict": {"const": "pending"}}, "required": ["measurementVerdict"]},
          "then": {"properties": {"verdictReason": {"enum": [null, "awaitingRetry", "interrupted"]}}}
        }
      ]
    },
    "clientSpansV1": {
      "description": "The three plan-07 client spans. In spans they are uptime-based; in continuousSpans they are sleep-inclusive (contract section 5.3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["timeToResultMs", "readyForNextRepMs", "saveConfirmedAfterRecordingMs"],
      "properties": {
        "timeToResultMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "readyForNextRepMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "saveConfirmedAfterRecordingMs": {"$ref": "#/$defs/nonNegNumberOrNull"}
      }
    },
    "runSummaryBodyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "failure",
        "cancellationReason",
        "priority",
        "reviewRequest",
        "poseDelegateRequested",
        "poseDelegateActual",
        "poseDelegateFallbackReason",
        "yoloComputeUnits",
        "modelCacheState",
        "stages",
        "passIds",
        "totals",
        "resources"
      ],
      "properties": {
        "outcome": {"$ref": "#/$defs/outcomeV1"},
        "failure": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "stage", "disposition", "layer"],
              "properties": {
                "code": {"$ref": "#/$defs/failureCode"},
                "stage": {"$ref": "#/$defs/stageId"},
                "disposition": {"type": "string", "pattern": "^[a-z][A-Za-z]{0,63}$"},
                "layer": {"$ref": "#/$defs/failureLayer"}
              }
            }
          ]
        },
        "cancellationReason": {"type": ["string", "null"], "maxLength": 64, "pattern": "^[a-z][A-Za-z0-9]*$"},
        "priority": {"enum": ["liveRep", "debug", "recovery"]},
        "reviewRequest": {"enum": ["none", "debugOverlay"]},
        "poseDelegateRequested": {"enum": ["cpu", "gpu"]},
        "poseDelegateActual": {"enum": ["cpu", "gpu", null]},
        "poseDelegateFallbackReason": {"type": ["string", "null"], "pattern": "^[a-z][A-Za-z0-9_.]{0,95}$"},
        "yoloComputeUnits": {"enum": ["all", "cpuAndGPU", "cpuOnly", "cpuAndNeuralEngine", "notLoaded", "unknown"]},
        "modelCacheState": {"enum": ["cold", "warm", "reloaded", "unknown"]},
        "stages": {"type": "array", "maxItems": 48, "items": {"$ref": "#/$defs/stageSummaryV1"}},
        "passIds": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/stageId"}},
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admissionWaitMs", "processingMs", "journalFinalizeMs", "framesDecoded", "modelCalls"],
          "properties": {
            "admissionWaitMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
            "processingMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
            "journalFinalizeMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
            "framesDecoded": {"$ref": "#/$defs/nonNegIntegerOrNull"},
            "modelCalls": {"$ref": "#/$defs/nonNegIntegerOrNull"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admitted", "released", "sampledPeakBytes"],
          "properties": {
            "admitted": {"$ref": "#/$defs/resourceSampleOrNull"},
            "released": {"$ref": "#/$defs/resourceSampleOrNull"},
            "sampledPeakBytes": {"$ref": "#/$defs/nonNegIntegerOrNull"}
          }
        }
      }
    },
    "uploadGroupSummaryBodyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "category",
        "jobState",
        "uniqueObjectCount",
        "uniqueObjectBytes",
        "queueWaitMs",
        "knownBackoffMs",
        "cloudSaveMs",
        "transferAttemptCount",
        "successfulTransferCount",
        "failedTransferCount",
        "lifetimeRetryCount",
        "requiredCommitAcknowledged",
        "firestoreWriteMs"
      ],
      "properties": {
        "groupId": {"$ref": "#/$defs/uploadGroupId"},
        "category": {"enum": ["resultFiles", "optionalVideo", "legacyVideo", "diagnostics"]},
        "jobState": {"enum": ["notRequested", "queued", "inProgress", "committed", "failed", "cancelled", "unavailable"]},
        "uniqueObjectCount": {"type": "integer", "minimum": 0, "maximum": 10000},
        "uniqueObjectBytes": {"type": "integer", "minimum": 0},
        "queueWaitMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "knownBackoffMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "cloudSaveMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "transferAttemptCount": {"type": "integer", "minimum": 0},
        "successfulTransferCount": {"type": "integer", "minimum": 0},
        "failedTransferCount": {"type": "integer", "minimum": 0},
        "lifetimeRetryCount": {"type": "integer", "minimum": 0},
        "requiredCommitAcknowledged": {"type": ["boolean", "null"]},
        "firestoreWriteMs": {"$ref": "#/$defs/nonNegNumberOrNull"}
      }
    },
    "transferInvocationV1": {
      "description": "TransferInvocationV1 (plan 07 section 4). Every key is present; optional values are explicit null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "logicalObjectId",
        "groupId",
        "outerCommitOrdinal",
        "objectOrdinal",
        "objectRole",
        "transport",
        "payloadBytes",
        "progressCompletedBytes",
        "queueWaitMs",
        "authorizationMs",
        "invocationElapsedMs",
        "knownBackoffMs",
        "observedPauseMs",
        "sdkInternalRetryCount",
        "networkInterface",
        "constrained",
        "expensive",
        "outcome",
        "providerDomain",
        "providerCode",
        "normalizedFailureCode",
        "failureStage"
      ],
      "properties": {
        "invocationId": {"$ref": "#/$defs/uuidLower"},
        "logicalObjectId": {"type": "string", "maxLength": 200, "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|system)/[A-Za-z0-9._-]{1,64}/[0-9a-f]{64}$"},
        "groupId": {"$ref": "#/$defs/uploadGroupId"},
        "outerCommitOrdinal": {"type": "integer", "minimum": 1, "maximum": 10000},
        "objectOrdinal": {"type": "integer", "minimum": 0, "maximum": 10000},
        "objectRole": {"enum": ["resultArtifact", "reprocessSidecar", "videoArchive", "freeRecordVideo", "stationFailureVideo", "diagnosticManifest", "diagnosticArtifact"]},
        "transport": {"enum": ["firebaseStoragePutData", "firebaseStoragePutFile", "urlSessionPut"]},
        "payloadBytes": {"type": "integer", "minimum": 0},
        "progressCompletedBytes": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "queueWaitMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "authorizationMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "invocationElapsedMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "knownBackoffMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "observedPauseMs": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "sdkInternalRetryCount": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "networkInterface": {"enum": ["wifi", "cellular", "wiredEthernet", "loopback", "other", "none", "unknown"]},
        "constrained": {"type": ["boolean", "null"]},
        "expensive": {"type": ["boolean", "null"]},
        "outcome": {"enum": ["succeeded", "failed", "cancelled", "interrupted", "unknown"]},
        "providerDomain": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
        "providerCode": {"type": ["integer", "null"]},
        "normalizedFailureCode": {"type": ["string", "null"], "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"},
        "failureStage": {"anyOf": [{"$ref": "#/$defs/stageId"}, {"type": "null"}]}
      }
    },
    "deviceStatusBodyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportReason",
        "collectionCapability",
        "repQueuePending",
        "repQueueFailed",
        "oldestPendingRepAgeSeconds",
        "diagnosticOutboxPending",
        "spoolRecordCount",
        "spoolBytes",
        "droppedRecordCount",
        "coverage"
      ],
      "properties": {
        "reportReason": {"enum": ["launch", "foreground", "attemptCompleted", "interval", "spoolDrain"]},
        "collectionCapability": {"enum": ["full", "partial", "disabled"]},
        "repQueuePending": {"type": "integer", "minimum": 0, "maximum": 64},
        "repQueueFailed": {"type": "integer", "minimum": 0, "maximum": 64},
        "oldestPendingRepAgeSeconds": {"$ref": "#/$defs/nonNegNumberOrNull"},
        "diagnosticOutboxPending": {"$ref": "#/$defs/nonNegIntegerOrNull"},
        "spoolRecordCount": {"type": "integer", "minimum": 0, "maximum": 1000},
        "spoolBytes": {"type": "integer", "minimum": 0, "maximum": 4194304},
        "droppedRecordCount": {"type": "integer", "minimum": 0},
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attemptsObserved", "runsObserved", "recordsQueued", "recordsAcknowledged", "recordsDropped"],
          "properties": {
            "attemptsObserved": {"type": "integer", "minimum": 0},
            "runsObserved": {"type": "integer", "minimum": 0},
            "recordsQueued": {"type": "integer", "minimum": 0},
            "recordsAcknowledged": {"type": "integer", "minimum": 0},
            "recordsDropped": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "recordV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performanceSchemaVersion",
        "recordKind",
        "recordId",
        "revision",
        "attemptId",
        "processingRunId",
        "retryOfRunId",
        "repId",
        "commitJobId",
        "originInstallId",
        "executorInstallId",
        "originLaunchId",
        "executionLaunchId",
        "stationDeviceId",
        "originReporterUid",
        "drillType",
        "recordingMode",
        "processingMode",
        "originPlatform",
        "executorPlatform",
        "captureFingerprint",
        "modelFingerprint",
        "policyVersion",
        "occurredAtClient",
        "captureOccurredAtClient",
        "clockQuality",
        "completeness",
        "missingReasons",
        "droppedDetailCount",
        "origin",
        "evaluationRunId",
        "body"
      ],
      "properties": {
        "performanceSchemaVersion": {"const": 1},
        "recordKind": {"enum": ["attemptSummary", "runSummary", "uploadGroupSummary", "transferInvocation", "deviceStatus"]},
        "recordId": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "attemptId": {"anyOf": [{"$ref": "#/$defs/uuidLower"}, {"type": "null"}]},
        "processingRunId": {"anyOf": [{"$ref": "#/$defs/uuidLower"}, {"type": "null"}]},
        "retryOfRunId": {"anyOf": [{"$ref": "#/$defs/uuidLower"}, {"type": "null"}]},
        "repId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,128}$"},
        "commitJobId": {"anyOf": [{"$ref": "#/$defs/uuidAnyCase"}, {"type": "null"}]},
        "originInstallId": {"anyOf": [{"$ref": "#/$defs/uuidLower"}, {"type": "null"}]},
        "executorInstallId": {"anyOf": [{"$ref": "#/$defs/uuidLower"}, {"type": "null"}]},
        "originLaunchId": {"anyOf": [{"$ref": "#/$defs/launchId"}, {"type": "null"}]},
        "executionLaunchId": {"anyOf": [{"$ref": "#/$defs/launchId"}, {"type": "null"}]},
        "stationDeviceId": {"anyOf": [{"$ref": "#/$defs/uuidAnyCase"}, {"type": "null"}]},
        "originReporterUid": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "drillType": {"anyOf": [{"$ref": "#/$defs/drillType"}, {"type": "null"}]},
        "recordingMode": {"enum": ["ordinary", "station", null]},
        "processingMode": {"anyOf": [{"$ref": "#/$defs/processingMode"}, {"type": "null"}]},
        "originPlatform": {"$ref": "#/$defs/platformRefOrNull"},
        "executorPlatform": {"$ref": "#/$defs/platformRefOrNull"},
        "captureFingerprint": {"anyOf": [{"$ref": "#/$defs/sha256Hex"}, {"type": "null"}]},
        "modelFingerprint": {"anyOf": [{"$ref": "#/$defs/sha256Hex"}, {"type": "null"}]},
        "policyVersion": {"$ref": "#/$defs/policyVersionOrNull"},
        "occurredAtClient": {"anyOf": [{"$ref": "#/$defs/clientTimestamp"}, {"type": "null"}]},
        "captureOccurredAtClient": {"anyOf": [{"$ref": "#/$defs/clientTimestamp"}, {"type": "null"}]},
        "clockQuality": {"enum": ["reliable", "uncertain", "future", "unavailable"]},
        "completeness": {"enum": ["complete", "partial", "pending"]},
        "missingReasons": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/missingReasonEntry"}},
        "droppedDetailCount": {"type": "integer", "minimum": 0},
        "origin": {"enum": ["field", "evaluation"]},
        "evaluationRunId": {"anyOf": [{"$ref": "#/$defs/uuidLower"}, {"type": "null"}]},
        "body": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"origin": {"const": "evaluation"}}, "required": ["origin"]},
          "then": {"properties": {"evaluationRunId": {"$ref": "#/$defs/uuidLower"}}},
          "else": {"properties": {"evaluationRunId": {"type": "null"}}}
        },
        {
          "if": {"properties": {"recordKind": {"const": "attemptSummary"}}, "required": ["recordKind"]},
          "then": {
            "properties": {
              "attemptId": {"$ref": "#/$defs/uuidLower"},
              "drillType": {"$ref": "#/$defs/drillType"},
              "body": {"$ref": "#/$defs/attemptSummaryBodyV1"}
            }
          }
        },
        {
          "if": {"properties": {"recordKind": {"const": "runSummary"}}, "required": ["recordKind"]},
          "then": {
            "properties": {
              "attemptId": {"$ref": "#/$defs/uuidLower"},
              "processingRunId": {"$ref": "#/$defs/uuidLower"},
              "drillType": {"$ref": "#/$defs/drillType"},
              "processingMode": {"$ref": "#/$defs/processingMode"},
              "policyVersion": {"$ref": "#/$defs/policyVersion"},
              "body": {"$ref": "#/$defs/runSummaryBodyV1"}
            }
          }
        },
        {
          "if": {"properties": {"recordKind": {"const": "uploadGroupSummary"}}, "required": ["recordKind"]},
          "then": {
            "properties": {
              "recordId": {"$ref": "#/$defs/uploadGroupId"},
              "body": {"$ref": "#/$defs/uploadGroupSummaryBodyV1"}
            },
            "if": {"properties": {"recordId": {"type": "string", "pattern": "^system:"}}, "required": ["recordId"]},
            "then": {"properties": {"attemptId": {"type": "null"}, "originInstallId": {"$ref": "#/$defs/uuidLower"}}},
            "else": {"properties": {"attemptId": {"$ref": "#/$defs/uuidLower"}}}
          }
        },
        {
          "if": {"properties": {"recordKind": {"const": "transferInvocation"}}, "required": ["recordKind"]},
          "then": {"properties": {"body": {"$ref": "#/$defs/transferInvocationV1"}}}
        },
        {
          "if": {"properties": {"recordKind": {"const": "deviceStatus"}}, "required": ["recordKind"]},
          "then": {
            "properties": {
              "recordId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:.{1,91}$"},
              "attemptId": {"type": "null"},
              "processingRunId": {"type": "null"},
              "executorInstallId": {"$ref": "#/$defs/uuidLower"},
              "originReporterUid": {"type": "string", "minLength": 1, "maxLength": 91},
              "body": {"$ref": "#/$defs/deviceStatusBodyV1"}
            }
          }
        }
      ]
    },
    "batchV1": {
      "description": "One ingestDevicePerformanceV1 request body. At most 16 records and 131072 encoded bytes.",
      "type": "object",
      "additionalProperties": false,
      "x-maxEncodedBytes": 131072,
      "required": ["performanceSchemaVersion", "batchId", "records"],
      "properties": {
        "performanceSchemaVersion": {"const": 1},
        "batchId": {"$ref": "#/$defs/uuidLower"},
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/recordV1", "x-maxEncodedBytes": 16384}
        }
      }
    },
    "ingestResponseV1": {
      "description": "Per-item ingestion result. One unsupported or oversized record never blocks the others.",
      "type": "object",
      "additionalProperties": false,
      "required": ["performanceSchemaVersion", "batchId", "results"],
      "properties": {
        "performanceSchemaVersion": {"const": 1},
        "batchId": {"$ref": "#/$defs/uuidLower"},
        "results": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "recordKind", "recordId", "revision", "status", "retryable", "acceptedRevision", "digest", "errorCode"],
            "properties": {
              "index": {"type": "integer", "minimum": 0, "maximum": 15},
              "recordKind": {"type": ["string", "null"], "maxLength": 32},
              "recordId": {"type": ["string", "null"], "maxLength": 128},
              "revision": {"type": ["integer", "null"], "minimum": 1},
              "status": {"enum": ["accepted", "duplicate", "superseded", "conflict", "rejected", "retryLater"]},
              "retryable": {"type": "boolean"},
              "acceptedRevision": {"type": ["integer", "null"], "minimum": 1},
              "digest": {"anyOf": [{"$ref": "#/$defs/sha256Hex"}, {"type": "null"}]},
              "errorCode": {
                "enum": [
                  null,
                  "invalidSchema",
                  "unsupportedVersion",
                  "oversizedRecord",
                  "oversizedBatch",
                  "evaluationOriginRejected",
                  "unauthorizedReporter",
                  "identityMismatch",
                  "dependencyPending",
                  "revisionConflict",
                  "staleRevision",
                  "illegalTransition",
                  "rateLimited",
                  "internal",
                  "attemptCapExceeded"
                ]
              }
            }
          }
        }
      }
    },
    "reportUploadRetentionV1": {
      "description": "Report fragment (contract section 8.4, v1.2.2, D-31 F3): the transfer-retention state that every upload-role statistic in the website's report carries. Only these keys are pinned; the rest of the report object is website-owned.",
      "type": "object",
      "required": ["retention", "groupsBeyondRetention"],
      "properties": {
        "retention": {"enum": ["retained", "partial", "notRetained"]},
        "groupsBeyondRetention": {"type": "integer", "minimum": 0}
      }
    },
    "reportOmittedReasonsV1": {
      "description": "Report fragment (contract section 8.4, v1.2.2, D-27, D-31 F8): why an outcome count's pending runs or pre-admission failures are null. A null reason means the count is present; a non-null reason means the count is null, never 0.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "preAdmissionFailures"],
      "properties": {
        "pending": {"enum": ["runFilterActive", "executorAttribution", null]},
        "preAdmissionFailures": {"enum": ["runFilterActive", null]}
      }
    },
    "reportCoverageV1": {
      "description": "Report fragment (contract section 8.4, v1.2.2, D-31 F1, F6): the coverage counters the contract names. Other coverage keys are website-owned.",
      "type": "object",
      "required": ["attemptsIndexed", "attemptsExcludedOverLimit", "attemptsUnknownDevice", "attemptsDeviceNotYetReported"],
      "properties": {
        "attemptsIndexed": {"type": "integer", "minimum": 0},
        "attemptsExcludedOverLimit": {"type": "integer", "minimum": 0},
        "attemptsUnknownDevice": {"type": "integer", "minimum": 0},
        "attemptsDeviceNotYetReported": {"type": "integer", "minimum": 0}
      }
    },
    "reportRunsExcludedByModeV1": {
      "description": "Report fragment (contract section 8.4, v1.2.2, D-31 F5): totals.runsExcludedByMode, the runs of the modes excluded from fleet processing statistics by default; null when a processing-mode filter selects the population.",
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
